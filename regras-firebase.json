{
  "rules": {
    "online": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "name": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 18"
        },
        "cls": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{1,24}$/)"
        },
        "sex": {
          ".validate": "newData.val() === 'm' || newData.val() === 'f'"
        },
        "ap": {
          ".validate": "newData.isString() && newData.val().matches(/^[0-9a-f]{6}\\.[0-9a-f]{6}\\.[0-9a-f]{6}\\.[A-Za-z0-9_-]{1,24}$/)"
        },
        "lvl": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999"
        },
        "x": {
          ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 6000"
        },
        "y": {
          ".validate": "newData.isNumber() && newData.val() >= -2000 && newData.val() <= 6000"
        },
        "fx": {
          ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
        },
        "fy": {
          ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
        },
        "hp": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
        },
        "dead": {
          ".validate": "newData.isBoolean()"
        },
        "dg": {
          ".validate": "newData.isBoolean()"
        },
        "eq": {
          "$slot": {
            ".validate": "$slot.matches(/^(he|ch|le|bo|ca|ne|sw|sh)$/) && newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{1,40}$/)"
          }
        },
        "sala": {
          ".validate": "newData.isString() && newData.val().length <= 80"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "pos": {
      "$sala": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.isString() && newData.val().length <= 900"
        }
      }
    },
    "ping": {
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    },
    "chat": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$msg": {
        ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().child('ultimaMsg').child(auth.uid).val() === now && (!root.child('ultimaMsg').child(auth.uid).exists() || root.child('ultimaMsg').child(auth.uid).val() < now - 700)) || (data.exists() && !newData.exists() && data.child('t').val() < now - 86400000))",
        ".validate": "newData.hasChildren(['uid', 'name', 'text', 't'])",
        "uid": {
          ".validate": "newData.isString()"
        },
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 18"
        },
        "text": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
        },
        "t": {
          ".validate": "newData.val() === now"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "chatSala": {
      "$sala": {
        ".read": "auth != null",
        ".indexOn": [
          "t"
        ],
        "$msg": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.parent().parent().parent().child('ultimaMsg').child(auth.uid).val() === now && (!root.child('ultimaMsg').child(auth.uid).exists() || root.child('ultimaMsg').child(auth.uid).val() < now - 700)) || (data.exists() && !newData.exists() && data.child('t').val() < now - 86400000))",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 't'])",
          "uid": {
            ".validate": "newData.isString()"
          },
          "name": {
            ".validate": "newData.isString() && newData.val().length <= 18"
          },
          "text": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 140"
          },
          "t": {
            ".validate": "newData.val() === now"
          },
          "$outro": {
            ".validate": false
          }
        }
      }
    },
    "salas": {
      "$sala": {
        ".read": "auth != null",
        ".write": "auth != null && !newData.exists() && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))",
        "mon": {
          ".write": "auth != null && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))",
          "$id": {
            ".validate": "newData.isString() && newData.val().length <= 120"
          }
        },
        "estado": {
          ".write": "auth != null && $sala === 'ilha:' + auth.uid",
          ".validate": "newData.isString() && newData.val().length <= 400"
        },
        "portas": {
          ".write": "auth != null && $sala.beginsWith('dg:' + auth.uid + ':')",
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "mortes": {
          ".write": "auth != null && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))",
          "$id": {
            ".validate": "newData.hasChildren(['id', 't'])"
          }
        },
        "tg": {
          ".write": "auth != null && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))",
          "$id": {
            ".validate": "newData.hasChildren(['type', 'x', 'y', 'maxT', 't'])"
          }
        },
        "golpes": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('de').val() === auth.uid) || (!newData.exists() && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))))",
            ".validate": "newData.hasChildren(['de', 'id', 'd']) && newData.child('d').isNumber() && newData.child('d').val() >= 0 && newData.child('d').val() <= 100000"
          }
        },
        "apoio": {
          "$id": {
            ".write": "auth != null && ((!data.exists() && newData.child('de').val() === auth.uid) || (!newData.exists() && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))))",
            ".validate": "newData.hasChildren(['de', 't'])"
          }
        },
        "danos": {
          "$alvo": {
            "$id": {
              ".write": "auth != null && ((!data.exists() && ($sala === 'ilha:' + auth.uid || $sala.beginsWith('dg:' + auth.uid + ':'))) || (!newData.exists() && auth.uid === $alvo))",
              ".validate": "newData.hasChildren(['d'])"
            }
          }
        },
        "pvp": {
          "$id": {
            ".write": "auth != null && $sala.beginsWith('arena') && ((!data.exists() && newData.child('de').val() === auth.uid) || (!newData.exists() && data.child('de').val() === auth.uid))",
            ".validate": "newData.hasChildren(['de', 'tipo', 't']) && newData.child('tipo').val().matches(/^(golpe|morte)$/) && newData.child('t').val() === now"
          }
        },
        "stats": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && $sala.beginsWith('dg:')",
            ".validate": "newData.hasChildren(['n', 'd']) && newData.child('n').isString() && newData.child('n').val().length <= 18"
          }
        },
        "fx": {
          "$id": {
            ".write": "auth != null && $sala === 'taverna' && ((!data.exists() && newData.child('de').val() === auth.uid) || (!newData.exists() && data.child('de').val() === auth.uid))",
            ".validate": "newData.hasChildren(['de', 'tipo', 'x', 'y', 't']) && newData.child('tipo').val().matches(/^(cura|bencao|impacto)$/) && newData.child('t').val() === now"
          }
        }
      }
    },
    "mesas": {
      "$mesa": {
        ".read": "auth != null",
        ".validate": "$mesa.matches(/^(bar|tav|cas)[0-9]{1,2}$/)",
        "assentos": {
          "$i": {
            ".write": "auth != null && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))"
          }
        },
        "jogo": {
          ".write": "auth != null && ((!data.exists() && newData.child('dono').val() === auth.uid) || data.child('dono').val() === auth.uid || data.child('conv').hasChild(auth.uid) || data.child('jog/0').val() === auth.uid || data.child('jog/1').val() === auth.uid || data.child('jog/2').val() === auth.uid || data.child('jog/3').val() === auth.uid || (data.child('t').val() < now - 600000 && (!newData.exists() || newData.child('dono').val() === auth.uid)))",
          "espect": {
            "$u": {
              ".write": "auth != null && auth.uid === $u"
            }
          },
          "fila": {
            "$u": {
              ".write": "auth != null && auth.uid === $u"
            }
          },
          "nomes": {
            "$u": {
              ".write": "auth != null && auth.uid === $u",
              ".validate": "newData.isString() && newData.val().length <= 24"
            }
          },
          "pago": {
            "$u": {
              ".write": "auth != null && auth.uid === $u"
            }
          },
          "premio": {
            "$u": {
              ".write": "auth != null && auth.uid === $u"
            }
          },
          "aposta": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
          }
        }
      }
    },
    "cassino": {
      "$mesa": {
        ".read": "auth != null",
        ".validate": "$mesa.matches(/^(rol|bj)[0-9]{1,2}$/)",
        "estado": {
          ".write": "auth != null"
        },
        "assentos": {
          "$i": {
            ".write": "auth != null && ((newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.val() === auth.uid))"
          }
        },
        "apostas": {
          "$n": {
            ".write": "auth != null && !newData.exists()",
            "$u": {
              ".write": "auth != null && auth.uid === $u"
            }
          }
        }
      }
    },
    "cassinoFeed": {
      ".read": "auth != null",
      ".indexOn": ["t"],
      "$id": {
        ".write": "auth != null && ((!data.exists() && newData.child('u').val() === auth.uid) || (!newData.exists() && data.child('t').val() < now - 3600000))",
        ".validate": "!newData.exists() || (newData.hasChildren(['u', 'm', 'v', 't']) && newData.child('v').isNumber() && newData.child('v').val() > 0 && newData.child('v').val() <= 500000 && newData.child('t').val() <= now + 60000)"
      }
    },
    "arenas": {
      "$lider": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $lider",
        "membros": {
          "$uid": {
            ".write": "auth != null && (auth.uid === $uid || auth.uid === $lider)"
          }
        },
        "mortos": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "convites": {
      "$para": {
        ".read": "auth != null && auth.uid === $para",
        ".write": "auth != null && auth.uid === $para && !newData.exists()",
        "$de": {
          ".write": "auth != null && (auth.uid === $de || auth.uid === $para)",
          ".validate": "newData.hasChildren(['tipo', 'nome', 't']) && newData.child('tipo').val().matches(/^(ilha|grupo|amizade|arena)$/) && newData.child('nome').isString() && newData.child('nome').val().length <= 18 && newData.child('t').val() === now"
        }
      }
    },
    "grupos": {
      "$lider": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $lider",
        "lider": {
          ".validate": "newData.val() === $lider"
        },
        "membros": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && !newData.exists()) || (auth.uid === $uid && root.child('convites').child($uid).child($lider).child('tipo').val() === 'grupo' && root.child('grupos').child($lider).exists()))",
            ".validate": "newData.isString() && newData.val().length <= 18"
          }
        },
        "dg": {
          ".validate": "newData.hasChildren(['id', 'sala', 'n']) && newData.child('sala').val().beginsWith('dg:' + $lider + ':') && newData.child('n').val() <= 5"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "amigos": {
      "$dono": {
        ".read": "auth != null && auth.uid === $dono",
        ".write": "auth != null && auth.uid === $dono && !newData.exists()",
        "$amigo": {
          ".write": "auth != null && (auth.uid === $dono || (auth.uid === $amigo && (!newData.exists() || root.child('convites').child($amigo).child($dono).child('tipo').val() === 'amizade')))",
          ".validate": "newData.isString() && newData.val().length <= 18"
        }
      }
    },
    "sussurros": {
      "$para": {
        ".read": "auth != null && auth.uid === $para",
        ".write": "auth != null && auth.uid === $para && !newData.exists()",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('de').val() === auth.uid && newData.parent().parent().parent().child('ultimaMsg').child(auth.uid).val() === now && (!root.child('ultimaMsg').child(auth.uid).exists() || root.child('ultimaMsg').child(auth.uid).val() < now - 700)) || (!newData.exists() && auth.uid === $para))",
          ".validate": "newData.hasChildren(['de', 'nome', 'text', 't']) && newData.child('text').isString() && newData.child('text').val().length >= 1 && newData.child('text').val().length <= 140 && newData.child('nome').isString() && newData.child('nome').val().length <= 18 && newData.child('t').val() === now"
        }
      }
    },
    "voz": {
      "$sala": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nome', 't'])"
        }
      }
    },
    "sinal": {
      "$para": {
        ".read": "auth != null && auth.uid === $para",
        "$id": {
          ".write": "auth != null && ((!data.exists() && newData.child('de').val() === auth.uid) || (!newData.exists() && auth.uid === $para))",
          ".validate": "newData.hasChildren(['de', 'sala', 'tipo', 't']) && newData.child('tipo').val().matches(/^(offer|answer|ice)$/)"
        }
      }
    },
    "ultimaMsg": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.val() === now"
      }
    },
    "perfis": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid",
        "nome": {
          ".validate": "newData.isString() && newData.val().length >= 3 && newData.val().length <= 18"
        },
        "criado": {
          ".validate": "newData.isBoolean()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "nomes": {
      ".read": "auth != null",
      "$chave": {
        ".write": "auth != null && ((!data.exists() || data.val() === auth.uid) && (newData.val() === auth.uid || !newData.exists()))",
        ".validate": "$chave.matches(/^[a-z0-9]{3,18}$/) && newData.val() === auth.uid"
      }
    },
    "saves": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['t', 'dados'])",
        "t": {
          ".validate": "newData.isNumber() && newData.val() <= now + 120000"
        },
        "dados": {
          ".validate": "newData.isString() && newData.val().length <= 300000"
        },
        "slots": {
          "$slot": {
            ".validate": "$slot.matches(/^s[1-3]$/) && newData.isString() && newData.val().length <= 300000"
          }
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "backups": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$dia": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "$dia.matches(/^d[0-2]$/) && newData.hasChildren(['t', 'dados']) && newData.child('t').isNumber() && newData.child('dados').isString() && newData.child('dados').val().length <= 300000"
        }
      }
    },
    "sessoes": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && (!newData.exists() || !data.exists() || data.child('id').val() === newData.child('id').val() || data.child('t').val() < now - 90000)",
        ".validate": "newData.hasChildren(['id', 't']) && newData.child('id').isString() && newData.child('id').val().length <= 40 && newData.child('t').val() === now"
      }
    },
    "viajante": {
      ".read": "auth != null",
      ".indexOn": [
        "t"
      ],
      "$id": {
        ".write": "auth != null",
        ".validate": "newData.hasChildren(['de', 'nome', 'id', 'n', 'preco', 't']) && $id.beginsWith(newData.child('id').val() + '__')",
        "de": {
          ".validate": "newData.isString() && (newData.val() === auth.uid || newData.val() === data.val())"
        },
        "nome": {
          ".validate": "newData.isString() && newData.val().length <= 18"
        },
        "id": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Za-z0-9_]{1,40}$/) && (!data.exists() || newData.val() === data.val())"
        },
        "q": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100 && (!data.exists() || newData.val() === data.val())"
        },
        "n": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 999999"
        },
        "preco": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000000 && (!data.exists() || newData.val() === data.val())"
        },
        "t": {
          ".validate": "newData.isNumber()"
        },
        "$outro": {
          ".validate": false
        }
      }
    },
    "ranqueada": {
      "fila": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "ranking": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['nome', 'pontos']) && newData.child('pontos').isNumber() && newData.child('pontos').val() >= 0 && newData.child('pontos').val() <= 100000 && (!data.exists() || (newData.child('pontos').val() - data.child('pontos').val() <= 50 && data.child('pontos').val() - newData.child('pontos').val() <= 50)) && newData.child('nome').isString() && newData.child('nome').val().length <= 24"
        }
      }
    },
    "suspeitas": {
      "$uid": {
        ".read": false,
        "$id": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.hasChildren(['t', 'm']) && newData.child('m').isString() && newData.child('m').val().length <= 80 && newData.child('t').isNumber() && newData.child('t').val() <= now"
        }
      }
    }
  }
}
